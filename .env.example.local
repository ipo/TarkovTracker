# Local-storage development without a Supabase project, account, or login.
# Copy this file to .env before `pnpm install && pnpm run dev`.
#
# Dummy public values for the shared Supabase env vars read by nuxt.config.ts
# and app/utils/runtimeConfig.ts. Keep both empty: Nuxt accepts a complete
# empty pair, and empty credentials activate offline localStorage mode.
# Filling only one value fails boot. Replace both with a real project only
# if you need login or sync.
#
# Naming convention:
#   SUPABASE_*       — shared Supabase project settings (Nuxt, Pages, Workers, Edge Functions)
#   NUXT_*           — Nuxt private runtime config (server-only)
#   NUXT_PUBLIC_*    — Nuxt public runtime config (browser-exposed)

# === REQUIRED PAIR: public Supabase runtime config
SUPABASE_URL=
SUPABASE_ANON_KEY=
