# Empty pair: local-storage mode. Set both or neither; one alone fails boot.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Scalar public keys: NUXT_PUBLIC_STATIC_QUEST_MODE maps to public.staticQuestMode.
# Do not use NUXT_PUBLIC_STATIC_QUEST_DATA; Nuxt would overwrite an object key.
NUXT_PUBLIC_STATIC_QUEST_MODE=true
NUXT_PUBLIC_STATIC_QUEST_DATA_BASE_URL=/quest-data
